{
  "name": "contextforge",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hostable RAG answer bot with citation grounding and abstain-on-uncertainty, for teams who can't afford Glean or Intercom Fin.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "npm run widget:build && next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "eval": "tsx eval/run.ts",
    "widget:build": "node widget/build.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx lib/db/migrate.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.2.0",
    "@ai-sdk/openai": "^1.3.0",
    "ai": "^4.3.0",
    "cheerio": "^1.0.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "next": "15.5.20",
    "pdf-parse": "^1.1.1",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.24.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
